; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text.

config_version=5

[application]

config/name="CEA GRENOBLE - Logistique 3D Warehouse"
config/description="Simulateur d'entrepôt logistique haute précision pour le CEA Grenoble (Racks, Tiroirs animés, Terminal Zebra WMS, Étiquettes EAN-128)"
run/main_scene="res://scenes/MainWarehouse.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

